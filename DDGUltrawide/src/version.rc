#include <winres.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION DDGU_VERSION_MAJOR, DDGU_VERSION_MINOR, DDGU_VERSION_PATCH, 0
 PRODUCTVERSION DDGU_VERSION_MAJOR, DDGU_VERSION_MINOR, DDGU_VERSION_PATCH, 0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "DDGUltrawide"
            VALUE "FileDescription", "DDGUltrawide: ultrawide display for Densha de Go!! AC (proxy version.dll)"
            VALUE "FileVersion", DDGU_VERSION_STRING
            VALUE "InternalName", "DDGUltrawide"
            VALUE "OriginalFilename", "version.dll"
            VALUE "ProductName", "DDGUltrawide"
            VALUE "ProductVersion", DDGU_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
